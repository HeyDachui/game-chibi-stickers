{"from": "AION2-DY-7651804247117275810-001", "type": "before", "to": "AION2-DY-7651804247117275810-006", "basis": "source", "source_refs": [{"source_id": "7651804247117275810", "locator": "口播第4段，00:05.26—00:06.54", "quote": "咱们给它刻印一下"}, {"source_id": "7651804247117275810", "locator": "口播第8段，00:16.03—00:18.53", "quote": "当它刻印出被动技能的时候"}, {"source_id": "7651804247117275810", "locator": "口播第9段，00:18.53—00:21.07", "quote": "那么它就属于是百分百刻印率"}, {"source_id": "7651804247117275810", "locator": "口播第14段，00:33.65—00:37.61", "quote": "当咱们拥有了30件百分百刻印率的装备以后"}, {"source_id": "7651804247117275810", "locator": "口播第15段，00:37.61—00:40.37", "quote": "咱们就能够获得完美主义者的称号"}], "condition": "收集到30件刻印成功率达到100%的装备"}
{"from": "AION2-DY-7690833260200430884-007", "type": "before", "to": "AION2-DY-7690833260200430884-008", "basis": "source", "source_refs": [{"source_id": "7690833260200430884", "locator": "口播第17段，00:48.98—00:51.84", "quote": "先使用悠悠加速器加速Steam"}, {"source_id": "7690833260200430884", "locator": "口播第18段，00:51.84—00:54.12", "quote": "然后我们节点选新加坡"}, {"source_id": "7690833260200430884", "locator": "口播第19段，00:54.12—00:57.38", "quote": "再到Steam界面右上方钱包处"}, {"source_id": "7690833260200430884", "locator": "口播第20段，00:57.62—00:59.04", "quote": "将你的地区"}, {"source_id": "7690833260200430884", "locator": "口播第21段，00:59.04—01:00.38", "quote": "改成新加坡"}]}
{"from": "AION2-DY-7689876326244715817-008", "type": "before", "to": "AION2-DY-7689876326244715817-011", "basis": "source", "source_refs": [{"source_id": "7689876326244715817", "locator": "口播第21段，00:51.58—00:53.74", "quote": "我们需要练四个22级角色"}, {"source_id": "7689876326244715817", "locator": "口播第26段，01:00.18—01:02.08", "quote": "我们把四个角色都练完之后呢"}, {"source_id": "7689876326244715817", "locator": "口播第27段，01:02.08—01:04.44", "quote": "然后我们就可以一个角色练到45级"}]}
{"from": "AION2-DY-7689876326244715817-011", "type": "before", "to": "AION2-DY-7689876326244715817-012", "basis": "source", "source_refs": [{"source_id": "7689876326244715817", "locator": "口播第27段，01:02.08—01:04.44", "quote": "然后我们就可以一个角色练到45级"}, {"source_id": "7689876326244715817", "locator": "口播第28段，01:04.44—01:06.30", "quote": "然后把开服之后"}, {"source_id": "7689876326244715817", "locator": "口播第32段，01:10.70—01:11.92", "quote": "我们把这些都清完"}]}
{"from": "AION2-DY-7689876326244715817-012", "type": "before", "to": "AION2-DY-7689876326244715817-013", "basis": "source", "source_refs": [{"source_id": "7689876326244715817", "locator": "口播第32段，01:10.70—01:11.92", "quote": "我们把这些都清完"}, {"source_id": "7689876326244715817", "locator": "口播第33段，01:11.92—01:14.14", "quote": "然后我们再去练第二个第三个第四个号"}]}
{"from": "AION2-DY-7689876326244715817-013", "type": "before", "to": "AION2-DY-7689876326244715817-015", "basis": "source", "source_refs": [{"source_id": "7689876326244715817", "locator": "口播第34段，01:14.14—01:16.78", "quote": "我们把四个号都清完之后呢"}, {"source_id": "7689876326244715817", "locator": "口播第38段，01:22.30—01:25.40", "quote": "我们把体力还有门票全都清完之后"}, {"source_id": "7689876326244715817", "locator": "口播第39段，01:25.40—01:27.40", "quote": "我们就可以把我们的四联号"}, {"source_id": "7689876326244715817", "locator": "口播第40段，01:27.40—01:29.18", "quote": "也把账号也都除掉了"}]}
{"from": "AION2-DY-7689876326244715817-015", "type": "before", "to": "AION2-DY-7689876326244715817-017", "basis": "source", "source_refs": [{"source_id": "7689876326244715817", "locator": "口播第43段，01:32.90—01:34.28", "quote": "我们把号除掉之后"}, {"source_id": "7689876326244715817", "locator": "口播第44段，01:34.28—01:36.10", "quote": "我们再观察一下吉纳的价格"}, {"source_id": "7689876326244715817", "locator": "口播第45段，01:36.10—01:38.34", "quote": "如果说吉纳价格还是比较高的"}, {"source_id": "7689876326244715817", "locator": "口播第46段，01:38.34—01:39.68", "quote": "我们再重新弄一个号"}, {"source_id": "7689876326244715817", "locator": "口播第47段，01:39.68—01:42.92", "quote": "重复刚才这个号的这样操作就行了"}]}
{"from": "AION2-DY-7689876326244715817-017", "type": "alternative", "to": "AION2-DY-7689876326244715817-018", "basis": "source", "source_refs": [{"source_id": "7689876326244715817", "locator": "口播第45段，01:36.10—01:38.34", "quote": "如果说吉纳价格还是比较高的"}, {"source_id": "7689876326244715817", "locator": "口播第46段，01:38.34—01:39.68", "quote": "我们再重新弄一个号"}, {"source_id": "7689876326244715817", "locator": "口播第47段，01:39.68—01:42.92", "quote": "重复刚才这个号的这样操作就行了"}, {"source_id": "7689876326244715817", "locator": "口播第48段，01:42.92—01:44.30", "quote": "如果价格不高呢"}, {"source_id": "7689876326244715817", "locator": "口播第49段，01:44.30—01:45.72", "quote": "我们就可以休息等会去了"}], "condition": "根据卖号后的基纳价格决定是否继续"}
{"from": "AION2-DY-7690449288039599379-017", "type": "before", "to": "AION2-DY-7690449288039599379-021", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第35段，03:50.06—03:51.68", "quote": "我们进游戏的第一时间,"}, {"source_id": "7690449288039599379", "locator": "口播第36段，03:51.86—03:54.88", "quote": "我们要做的就是去创建角色,"}, {"source_id": "7690449288039599379", "locator": "口播第37段，03:55.18—03:57.54", "quote": "把所有的角色先创建码,"}, {"source_id": "7690449288039599379", "locator": "口播第43段，04:08.40—04:12.02", "quote": "随之我们把五个角色第一天全部练到22级左右,"}]}
{"from": "AION2-DY-7690449288039599379-021", "type": "before", "to": "AION2-DY-7690449288039599379-026", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第43段，04:08.40—04:12.02", "quote": "随之我们把五个角色第一天全部练到22级左右,"}, {"source_id": "7690449288039599379", "locator": "口播第65段，04:49.90—04:53.52", "quote": "其实就刚好够把5个角色练到22级,"}, {"source_id": "7690449288039599379", "locator": "口播第66段，04:54.36—04:56.06", "quote": "其次我们到第二天的时候,"}, {"source_id": "7690449288039599379", "locator": "口播第67段，04:56.08—05:00.66", "quote": "就是要开始清理5个角色的主线和支线,"}]}
{"from": "AION2-DY-7690449288039599379-026", "type": "before", "to": "AION2-DY-7690449288039599379-033", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第85段，05:36.26—05:40.34", "quote": "其次就是我们刚好到第6天的时候,"}, {"source_id": "7690449288039599379", "locator": "口播第86段，05:40.36—05:42.94", "quote": "就是5个角色刚好全部清理完毕,"}, {"source_id": "7690449288039599379", "locator": "口播第90段，05:49.44—05:51.94", "quote": "下周三之前也就是我们的下周二左右,"}, {"source_id": "7690449288039599379", "locator": "口播第91段，05:51.96—05:53.58", "quote": "我们要开始购买奥德能量,"}]}
{"from": "AION2-DY-7690449288039599379-021", "type": "before", "to": "AION2-DY-7690449288039599379-036", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第43段，04:08.40—04:12.02", "quote": "随之我们把五个角色第一天全部练到22级左右,"}, {"source_id": "7690449288039599379", "locator": "口播第111段，06:34.72—06:38.34", "quote": "这个小游戏我们刚好到周二的时候,"}, {"source_id": "7690449288039599379", "locator": "口播第112段，06:38.36—06:40.98", "quote": "我们所有角色都进行都已经45级了,"}, {"source_id": "7690449288039599379", "locator": "口播第113段，06:41.00—06:44.78", "quote": "这个时候45级他才会有一个金色装备的产出,"}]}
{"from": "AION2-DY-7690449288039599379-021", "type": "before", "to": "AION2-DY-7690449288039599379-043", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第51段，04:27.12—04:28.78", "quote": "开始我们的奥德能量恢复,"}, {"source_id": "7690449288039599379", "locator": "口播第53段，04:29.66—04:31.48", "quote": "他到我们第六天的时候,"}, {"source_id": "7690449288039599379", "locator": "口播第54段，04:31.50—04:32.78", "quote": "我们就可以进行一个打本,"}, {"source_id": "7690449288039599379", "locator": "口播第137段，07:33.36—07:35.74", "quote": "征服副本到我们周二的时候,"}, {"source_id": "7690449288039599379", "locator": "口播第138段，07:35.76—07:37.34", "quote": "基本上我们的奥德能量也就够了,"}, {"source_id": "7690449288039599379", "locator": "口播第139段，07:37.36—07:41.34", "quote": "所以说这个时候我们来进行一个征服副本的一个击杀,"}]}
{"from": "AION2-DY-7690449288039599379-026", "type": "before", "to": "AION2-DY-7690449288039599379-064", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第234段，11:02.06—11:06.20", "quote": "其次就是我们第一周大概能起五个角色左右,"}, {"source_id": "7690449288039599379", "locator": "口播第235段，11:06.22—11:07.88", "quote": "我们要进行第二周的时候呢,"}, {"source_id": "7690449288039599379", "locator": "口播第236段，11:07.90—11:10.92", "quote": "这个时候我们大概就要开始选择扩充角色了,"}]}
{"from": "AION2-DY-7690449288039599379-070", "type": "before", "to": "AION2-DY-7690449288039599379-071", "basis": "source", "source_refs": [{"source_id": "7690449288039599379", "locator": "口播第269段，12:21.73—12:23.51", "quote": "推荐大家还是刷这个宠物力啊,"}, {"source_id": "7690449288039599379", "locator": "口播第270段，12:23.53—12:25.23", "quote": "其次就是这个强化石,"}, {"source_id": "7690449288039599379", "locator": "口播第271段，12:25.25—12:26.89", "quote": "当你的宠物等级够高的时候,"}, {"source_id": "7690449288039599379", "locator": "口播第272段，12:26.91—12:29.49", "quote": "我们可以选择回来刷这个强化石,"}], "condition": "宠物等级已经够高"}
